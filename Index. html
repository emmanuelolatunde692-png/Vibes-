<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vibes</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f3f4f6;
  color: #111827;
}

header {
  background: #111827;
  color: white;
  padding: 16px;
  text-align: center;
  font-size: 26px;
  font-weight: bold;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search {
  padding: 12px;
  background: white;
  position: sticky;
  top: 58px;
  z-index: 9;
}

.search input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 20px;
  font-size: 15px;
}

nav {
  display: flex;
  justify-content: space-around;
  background: white;
  padding: 12px 5px;
  border-bottom: 1px solid #ddd;
  position: sticky;
  top: 116px;
  z-index: 8;
}

nav button {
  background: none;
  color: #111827;
  padding: 8px;
  border: none;
  font-size: 14px;
}

.container {
  max-width: 600px;
  margin: auto;
}

.welcome {
  background: white;
  margin: 12px;
  padding: 18px;
  border-radius: 14px;
}

.post {
  background: white;
  margin: 12px;
  padding: 16px;
  border-radius: 14px;
}

.user {
  font-weight: bold;
  margin-bottom: 10px;
}

.post h2 {
  margin-top: 5px;
}

.actions {
  display: flex;
  justify-content: space-around;
  margin-top: 15px;
  border-top: 1px solid #eee;
  padding-top: 12px;
}

.actions button {
  background: none;
  color: #111827;
  border: none;
  font-size: 14px;
}

.liked {
  color: red !important;
}

.comment-box {
  display: none;
  margin-top: 12px;
}

.comment-box input {
  width: 75%;
  padding: 9px;
  border: 1px solid #ddd;
  border-radius: 8px;
}

.comment-box button {
  padding: 9px;
  background: #111827;
  color: white;
  border: none;
  border-radius: 8px;
}

.comments {
  margin-top: 8px;
  font-size: 14px;
}

.profile {
  display: none;
  background: white;
  margin: 12px;
  padding: 20px;
  border-radius: 14px;
  text-align: center;
}

.profile-circle {
  width: 70px;
  height: 70px;
  background: #111827;
  color: white;
  border-radius: 50%;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
}

@media (min-width: 700px) {
  .container {
    max-width: 650px;
  }
}
</style>
</head>

<body>

<header>VIBES</header>

<div class="search">
  <input
    type="text"
    id="search"
    placeholder="Search Vibes..."
    onkeyup="searchPosts()">
</div>

<nav>
  <button onclick="showHome()">🏠 Home</button>
  <button onclick="showTrending()">🔥 Trending</button>
  <button onclick="showProfile()">👤 Profile</button>
</nav>

<div class="container">

<div id="home">

<div class="welcome">
  <h1>Welcome to Vibes 👋</h1>
  <p>Your daily news, your way.</p>
</div>

<div class="post">
  <div class="user">Vibes News</div>
  <h2>📰 Today's News</h2>
  <p>Discover what's happening around you and around the world.</p>

  <div class="actions">
    <button onclick="likePost(this)">❤️ Like <span>0</span></button>
    <button onclick="toggleComment(this)">💬 Comment</button>
    <button onclick="sharePost()">🔄 Share</button>
  </div>

  <div class="comment-box">
    <input type="text" placeholder="Write a comment...">
    <button onclick="addComment(this)">Post</button>
    <div class="comments"></div>
  </div>
</div>

<div class="post">
  <div class="user">Trending Vibes</div>
  <h2>🔥 Trending Vibes</h2>
  <p>See what people are talking about today.</p>

  <div class="actions">
    <button onclick="likePost(this)">❤️ Like <span>0</span></button>
    <button onclick="toggleComment(this)">💬 Comment</button>
    <button onclick="sharePost()">🔄 Share</button>
  </div>

  <div class="comment-box">
    <input type="text" placeholder="Write a comment...">
    <button onclick="addComment(this)">Post</button>
    <div class="comments"></div>
  </div>
</div>

</div>

<div id="profile" class="profile">
  <div class="profile-circle">V</div>
  <h2>Vibes User</h2>
  <p>Welcome to your Vibes profile.</p>
  <p>Posts: 0 &nbsp; Followers: 0 &nbsp; Following: 0</p>
</div>

</div>

<script>

function likePost(button) {
  let count = button.querySelector("span");
  let number = parseInt(count.textContent);

  if (button.classList.contains("liked")) {
    number--;
    button.classList.remove("liked");
  } else {
    number++;
    button.classList.add("liked");
  }

  count.textContent = number;
}

function toggleComment(button) {
  let post = button.closest(".post");
  let box = post.querySelector(".comment-box");

  if (box.style.display === "block") {
    box.style.display = "none";
  } else {
    box.style.display = "block";
  }
}

function addComment(button) {
  let box = button.parentElement;
  let input = box.querySelector("input");
  let comments = box.querySelector(".comments");

  if (input.value.trim() !== "") {
    let comment = document.createElement("p");
    comment.textContent = "💬 " + input.value;
    comments.appendChild(comment);
    input.value = "";
  }
}

function sharePost() {
  if (navigator.share) {
    navigator.share({
      title: "Vibes",
      text: "Check this out on Vibes!"
    });
  } else {
    alert("Vibes link is ready to share!");
  }
}

function showProfile() {
  document.getElementById("home").style.display = "none";
  document.getElementById("profile").style.display = "block";
}

function showHome() {
  document.getElementById("home").style.display = "block";
  document.getElementById("profile").style.display = "none";
}

function showTrending() {
  alert("Trending Vibes is coming soon!");
}

function searchPosts() {
  let input = document.getElementById("search").value.toLowerCase();
  let posts = document.querySelectorAll(".post");

  posts.forEach(function(post) {
    let text = post.textContent.toLowerCase();

    if (text.includes(input)) {
      post.style.display = "block";
    } else {
      post.style.display = "none";
    }
  });
}

</script>

</body>
</html>
